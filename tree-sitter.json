{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vue",
      "camelcase": "Vue",
      "title": "Vue",
      "scope": "source.vue",
      "file-types": [
        "vue"
      ],
      "injection-regex": "^vue$",
      "class-name": "TreeSitterVue"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Vue grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "tree-sitter-grammars/tree-sitter-vue",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}